<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<package format="1">
  <name>Cascadia PLM</name>
  <description>
    Cascadia PLM inside FreeCAD: the PLM web UI in a dock panel beside the 3D
    view, and an FCStd round-trip between Cascadia's file vault and a design-job
    working copy.
  </description>
  <version>0.1.0</version>
  <date>2026-08-27</date>
  <maintainer email="maxwell.simons@protonmail.com">Cascadia FreeCAD integration</maintainer>
  <license>UNLICENSED</license>
  <url type="repository" branch="main">https://github.com/balaclav4/FreeCAD-Cascadia-Addon</url>

  <!-- This addon needs a docked QWebEngineView and the standard workbench and
       command APIs, all of which are 1.0-era. The panel's placement was read
       from the 1.1.3 source, but nothing here depends on 1.1.x.

       Do not raise this to 1.1.3 to match the mechanical design agent: that is
       a separate, external component with its own certified FreeCAD build, and
       pinning the addon to it only stops the addon installing on FreeCADs it
       would run on perfectly well. -->
  <freecadmin>1.0</freecadmin>

  <content>
    <workbench>
      <classname>CascadiaWorkbench</classname>
      <name>Cascadia PLM</name>
      <description>
        Dock the Cascadia PLM interface next to the model, and move FCStd files
        between the vault and a design-job working copy.
      </description>
      <tag>PLM</tag>
      <tag>Cascadia</tag>
      <tag>PDM</tag>
    </workbench>
  </content>
</package>
